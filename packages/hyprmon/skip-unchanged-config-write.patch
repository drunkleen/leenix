+
+func TestWriteLuaConfigSkipsMainRewriteWhenRequirePresent(t *testing.T) {
+	dir := t.TempDir()
+	luaPath := filepath.Join(dir, "hyprland.lua")
+	input := strings.Join([]string{
+		"-- user config",
+		"-- hyprmon: managed monitor profile include",
+		`require("hyprmon")`,
+	}, "\n")
+	if err := os.WriteFile(luaPath, []byte(input), 0600); err != nil {
+		t.Fatal(err)
+	}
+	// Simulate an immutable/nix-managed main config: any write attempt fails.
+	if err := os.Chmod(luaPath, 0400); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("HYPRLAND_CONFIG", luaPath)
+
+	monitors := []Monitor{{Name: "eDP-1", Active: false}}
+
+	if err := writeConfig(monitors); err != nil {
+		t.Fatalf("writeConfig() with existing require on read-only main config = %v", err)
+	}
+
+	mainData, err := os.ReadFile(luaPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(mainData) != input {
+		t.Fatalf("main config was rewritten despite existing require:\n%s", mainData)
+	}
+
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, entry := range entries {
+		if strings.Contains(entry.Name(), ".bak.") {
+			t.Fatalf("unexpected backup %q created when main config unchanged", entry.Name())
+		}
+	}
+
+	sidecarData, err := os.ReadFile(filepath.Join(dir, "hyprmon.lua"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(string(sidecarData), `output = "eDP-1", disabled = true`) {
+		t.Fatalf("hyprmon.lua sidecar was not updated:\n%s", sidecarData)
+	}
+}
