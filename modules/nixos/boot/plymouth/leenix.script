# LEENIX Plymouth Theme Script
#
# After the LUKS password clears, a minimal LEENIUM "Arc Pulse" spinner is
# shown: two short asymmetric arcs (primary + secondary) rotate smoothly while a
# faint trail arc counter-rotates behind them. The motion conveys activity only
# - never a completion percentage. Plymouth's time-based BootProgress model
# assumes a ~60 s boot and therefore carries no honest determinate signal on a
# ~20 s NixOS boot, so no determinate/fake progress is used.
#
# The arcs are composed of small elongated tick sprites positioned along a ring
# with Math.Cos/Math.Sin; sprites are created once and only moved per refresh
# (no per-frame image allocation, no Image._Rotate).

Window.SetBackgroundTopColor(0.043, 0.067, 0.075);
Window.SetBackgroundBottomColor(0.043, 0.067, 0.075);

logo.image = Image("unlock.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2);
logo.sprite.SetOpacity(1);

#----------------------------------------- Arc Pulse Spinner --------------------------------
# Arc ticks: 10x3 px elongated segments, rounded caps, top-left anchored. The
# spinner is centred where the old loading track used to sit (vertically centred
# on the password entry), preserving the overall LEENIUM layout.

global.pi = 3.141592653589793;
global.deg = global.pi / 180.0;

global.spinner.active = 0;
global.spinner.frame = 0;
global.spinner.period_frames = 70;        # 1.4 s primary/secondary revolution @ 50 FPS
global.spinner.trail_period_frames = 100; # 2.0 s faint trail counter-revolution
global.spinner.radius = 14.0;
global.spinner.tick_w = 10.0;
global.spinner.tick_h = 3.0;
global.spinner.cx = 0.0;
global.spinner.cy = 0.0;

# group: 0 = primary arc, 1 = secondary arc, 2 = faint trail.
global.spinner.group = [ 0, 0, 0, 0,  1, 1, 1,  2, 2 ];
# Per-tick angular offset (deg) within its arc, spread so adjacent ticks
# overlap into a continuous-looking arc band.
global.spinner.tick_deg = [
  -37.5, -12.5, 12.5, 37.5,
  -20.0, 0.0, 20.0,
  -9.0, 9.0
];
# Fixed per-tick opacity: arc ends slightly softer, trail uniformly faint.
global.spinner.tick_opacity = [
  0.70, 1.0, 1.0, 0.70,
  0.70, 1.0, 0.70,
  0.33, 0.33
];
global.spinner.tick_sprites = [];
global.spinner.image_primary = Image("arc_tick_primary.png");
global.spinner.image_secondary = Image("arc_tick_secondary.png");

fun spinner_init() {
  global.spinner.cx = Window.GetWidth() / 2;
  global.spinner.cy = entry.y + entry.image.GetHeight() / 2;

  for (index = 0; index < 9; index++) {
    img = global.spinner.image_secondary;
    if (global.spinner.group[index] == 0)
      img = global.spinner.image_primary;

    sprite = Sprite(img);
    sprite.SetPosition(0, 0, 1000);
    sprite.SetOpacity(0);
    global.spinner.tick_sprites[index] = sprite;
  }
}

fun spinner_update() {
  global.spinner.frame++;
  primary = (global.spinner.frame % global.spinner.period_frames) / global.spinner.period_frames * 360.0;
  trail = (global.spinner.frame % global.spinner.trail_period_frames) / global.spinner.trail_period_frames * 360.0;

  for (index = 0; index < 9; index++) {
    group = global.spinner.group[index];

    if (group == 2)
      angle_deg = (60.0 - trail + global.spinner.tick_deg[index]) * global.deg;
    else if (group == 1)
      angle_deg = (primary + 150.0 + global.spinner.tick_deg[index]) * global.deg;
    else
      angle_deg = (primary + global.spinner.tick_deg[index]) * global.deg;

    x = global.spinner.cx + Math.Cos(angle_deg) * global.spinner.radius - global.spinner.tick_w / 2;
    y = global.spinner.cy + Math.Sin(angle_deg) * global.spinner.radius - global.spinner.tick_h / 2;
    global.spinner.tick_sprites[index].SetX(x);
    global.spinner.tick_sprites[index].SetY(y);
  }
}

fun show_spinner() {
  global.spinner.frame = 0;
  global.spinner.active = 1;
  for (index = 0; index < 9; index++)
    global.spinner.tick_sprites[index].SetOpacity(global.spinner.tick_opacity[index]);
}

fun hide_spinner() {
  global.spinner.active = 0;
  for (index = 0; index < 9; index++)
    global.spinner.tick_sprites[index].SetOpacity(0);
}

fun refresh_callback() {
  if (global.spinner.active == 1) {
    spinner_update();
  }
}

Plymouth.SetRefreshFunction(refresh_callback);

#----------------------------------------- Helper Functions --------------------------------

fun show_password_dialog() {
  lock.sprite.SetOpacity(1);
  entry.sprite.SetOpacity(1);
}

fun hide_password_dialog() {
  lock.sprite.SetOpacity(0);
  entry.sprite.SetOpacity(0);

  for (index = 0; bullet.sprites[index]; index++) {
    bullet.sprites[index].SetOpacity(0);
  }
}

#----------------------------------------- Dialogue --------------------------------

lock.image = Image("lock.png");
entry.image = Image("entry.png");
bullet.image = Image("bullet.png");

entry.sprite = Sprite(entry.image);
entry.x = Window.GetWidth() / 2 - entry.image.GetWidth() / 2;
entry.y = logo.sprite.GetY() + logo.image.GetHeight() + 40;
entry.sprite.SetPosition(entry.x, entry.y, 10001);
entry.sprite.SetOpacity(0);

# Scale lock to be slightly shorter than entry field height
# Original lock is 84x96, entry height determines scale
lock_height = entry.image.GetHeight() * 0.8;
lock_scale = lock_height / 96;
lock_width = 84 * lock_scale;

scaled_lock = lock.image.Scale(lock_width, lock_height);
lock.sprite = Sprite(scaled_lock);
lock.x = entry.x - lock_width - 15;
lock.y = entry.y + entry.image.GetHeight() / 2 - lock_height / 2;
lock.sprite.SetPosition(lock.x, lock.y, 10001);
lock.sprite.SetOpacity(0);

# Bullet array
bullet.sprites = [];

fun display_normal_callback() {
  hide_password_dialog();

  # Get current mode
  mode = Plymouth.GetMode();

  # After LUKS, show the Arc Pulse spinner for boot and resume modes
  if ((mode == "boot" || mode == "resume") && global.password_shown == 1) {
    show_spinner();
  }
}

fun display_password_callback(prompt, bullets) {
  global.password_shown = 1;  # Mark that password dialog has been shown

  # Hide the spinner while the password dialog is up
  hide_spinner();
  show_password_dialog();

  # Clear all bullets first
  for (index = 0; bullet.sprites[index]; index++) {
    bullet.sprites[index].SetOpacity(0);
  }

  # Create and show bullets for current password (max 21)
  max_bullets = 21;
  bullets_to_show = bullets;
  if (bullets_to_show > max_bullets) {
    bullets_to_show = max_bullets;
  }

  for (index = 0; index < bullets_to_show; index++) {
    if (!bullet.sprites[index]) {
      # Scale bullet image to 7x7 pixels
      scaled_bullet = bullet.image.Scale(7, 7);
      bullet.sprites[index] = Sprite(scaled_bullet);
      bullet.x = entry.x + 20 + index * (7 + 5);
      bullet.y = entry.y + entry.image.GetHeight() / 2 - 3.5;
      bullet.sprites[index].SetPosition(bullet.x, bullet.y, 10002);
    }

    bullet.sprites[index].SetOpacity(1);
  }
}

Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);

# Build the spinner sprites (after entry geometry is known).
spinner_init();

#----------------------------------------- Message --------------------------------

message_sprite = Sprite();
message_sprite.SetPosition(10, 10, 10000);

fun display_message_callback(text) {
  message = Image.Text(text, 0.847, 0.890, 0.878);
  message_sprite.SetImage(message);
  message_sprite.SetOpacity(1);
}

fun hide_message_callback(text) {
  message_sprite.SetOpacity(0);
}

Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);
